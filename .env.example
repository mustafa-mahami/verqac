# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=
VERQAC_OWNER_PASSWORD=
VERQAC_APP_PASSWORD=

VERQAC_ENV=prod
# at least 32 random characters: openssl rand -hex 32
VERQAC_JWT_SECRET=
VERQAC_COOKIE_SECURE=true
VERQAC_CORS_ORIGINS=["https://app.verqac.com"]
VERQAC_APP_URL=https://app.verqac.com

# Optional: e-mail (invitations and notifications). Without it, invitation links are copied by hand.
# VERQAC_SMTP_HOST=mail.example.com
# VERQAC_SMTP_PORT=587
# VERQAC_SMTP_USER=no-reply@verqac.com
# VERQAC_SMTP_PASSWORD=
# VERQAC_SMTP_FROM=Verqac <no-reply@verqac.com>

# Optional: Mahami push, same endpoint and key as the Odoo dr module
# VERQAC_MAHAMI_URL=https://api.vexoraflow.com
# VERQAC_MAHAMI_KEY=

# Reading lab certificates (PDF) with AI (Anthropic API). Without a key the AI button is hidden.
# VERQAC_AI_API_KEY=sk-ant-...
# VERQAC_AI_MODEL=claude-sonnet-5-5
