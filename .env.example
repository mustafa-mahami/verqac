# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=
VERQAC_OWNER_PASSWORD=
VERQAC_APP_PASSWORD=

VERQAC_ENV=prod
# at least 32 random characters: openssl rand -hex 32
VERQAC_JWT_SECRET=
VERQAC_COOKIE_SECURE=true
VERQAC_CORS_ORIGINS=["https://app.verqac.com"]
VERQAC_APP_URL=https://app.verqac.com
